generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String         @id @default(cuid())
  walletAddress             String         @unique
  username                  String?        @unique
  avatar                    String?
  bio                       String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  deletedAt                 DateTime?
  adminRole                 String?
  adminSince                DateTime?
  email                     String?        @unique
  lastLoginAt               DateTime?
  location                  String?
  notificationPreferences   Json?
  completedTransactionCount Int            @default(0)
  twitterHandle             String?        @unique
  twitterVerifiedAt         DateTime?
  adminPermissions          Json?
  brands                    Brand[]
  buyerConversations        Conversation[] @relation("ConversationBuyer")
  sellerConversations       Conversation[] @relation("ConversationSeller")
  favorites                 Favorite[]
  listings                  Listing[]
  ListingMedia              ListingMedia[]
  receivedMessages          Message[]      @relation("MessageReceiver")
  sentMessages              Message[]      @relation("MessageSender")
  notifications             Notification[]
  receivedOffers            Offer[]        @relation("OfferReceiver")
  offers                    Offer[]        @relation("OfferSender")
  submittedReports          Report[]       @relation("ReportSubmitter")
  reviews                   Review[]       @relation("ReviewAuthor")
  receivedReviews           Review[]       @relation("ReviewReceiver")
  buyerTransactions         Transaction[]  @relation("TransactionBuyer")
  sellerTransactions        Transaction[]  @relation("TransactionSeller")
}

model Listing {
  id              String         @id @default(cuid())
  title           String
  description     String
  price           Float
  category        String
  condition       String
  status          String         @default("active")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  brand           String?
  featured        Boolean        @default(false)
  deliveryOptions Json           @default("{\"noDelivery\": false, \"deliveryPrice\": 0, \"postalService\": false}")
  currency        Currency       @default(USD)
  favorites       Favorite[]
  user            User           @relation(fields: [userId], references: [id])
  media           ListingMedia[]
  offers          Offer[]
  reports         Report[]
  transactions    Transaction[]

  @@index([userId])
}

model ListingMedia {
  id               String   @id @default(cuid())
  url              String?
  type             String
  filename         String
  order            Int      @default(0)
  duration         Int?
  thumbnail        String?
  createdAt        DateTime @default(now())
  listingId        String?
  originalFilename String
  isMainMedia      Boolean  @default(false)
  processingError  String?
  status           String   @default("PENDING")
  updatedAt        DateTime
  userId           String
  listing          Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  User             User     @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  buyerId   String
  sellerId  String
  buyer     User      @relation("ConversationBuyer", fields: [buyerId], references: [id])
  seller    User      @relation("ConversationSeller", fields: [sellerId], references: [id])
  messages  Message[]

  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  createdAt      DateTime     @default(now())
  read           Boolean      @default(false)
  senderId       String
  receiverId     String
  attachments    Json?
  conversationId String
  metadata       Json?
  type           String?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  receiver       User         @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([conversationId])
}

model Offer {
  id          String       @id @default(cuid())
  amount      Float
  status      String       @default("pending")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  senderId    String
  receiverId  String
  listingId   String
  listing     Listing      @relation(fields: [listingId], references: [id])
  receiver    User         @relation("OfferReceiver", fields: [receiverId], references: [id])
  sender      User         @relation("OfferSender", fields: [senderId], references: [id])
  transaction Transaction?

  @@index([senderId])
  @@index([receiverId])
  @@index([listingId])
}

model Review {
  id            String      @id @default(cuid())
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  authorId      String
  receiverId    String
  transactionId String      @unique
  author        User        @relation("ReviewAuthor", fields: [authorId], references: [id])
  receiver      User        @relation("ReviewReceiver", fields: [receiverId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@unique([authorId, transactionId])
  @@index([authorId])
  @@index([receiverId])
  @@index([transactionId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Report {
  id          String   @id @default(cuid())
  reason      String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reporterId  String
  listingId   String
  attachments Json?
  description String?
  type        String
  listing     Listing  @relation(fields: [listingId], references: [id])
  reporter    User     @relation("ReportSubmitter", fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([listingId])
}

model Escrow {
  id            String      @id @default(cuid())
  address       String      @unique
  amount        Float
  status        String      @default("pending")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
}

model Transaction {
  id             String   @id @default(cuid())
  amount         Float
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  listingId      String
  offerId        String   @unique
  trackingNumber String?
  protectionFee  Float?
  shippingFee    Float?
  signature      String?
  buyerId        String
  sellerId       String
  escrow         Escrow?
  review         Review?
  buyer          User     @relation("TransactionBuyer", fields: [buyerId], references: [id])
  listing        Listing  @relation(fields: [listingId], references: [id])
  offer          Offer    @relation(fields: [offerId], references: [id])
  seller         User     @relation("TransactionSeller", fields: [sellerId], references: [id])

  @@index([listingId])
  @@index([offerId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  category  String
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([name, category])
  @@index([category])
  @@index([userId])
}

enum Currency {
  USD
  EUR
  GBP
}
